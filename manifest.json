{
  "manifest_version": 3,
  "name": "Jongo",
  "version": "1.0.0",
  "description": "Jongo",
  "permissions": ["storage"],
  "action": {
    "default_title": "Jongo (on)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "jongoprototype.png",
      "48": "jongoprototype.png",
      "128": "jongoprototype.png"
    }
  },
  "icons": {
    "16": "jongoprototype.png",
    "48": "jongoprototype.png",
    "128": "jongoprototype.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_shim.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pkg/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
