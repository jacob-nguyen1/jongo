{
  "manifest_version": 3,
  "name": "Jongo",
  "version": "1.0.0",
  "description": "Jongo",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Jongo (on)",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_shim.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pkg/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
